# Copy to .env and fill in. All providers default to "mock" so the
# pipeline runs end-to-end with zero keys (see `cleanroom demo`).

# --- Describer (LLM #1: video -> spec) ---
CLEANROOM_VISION_PROVIDER=mock        # mock | openai
CLEANROOM_VISION_MODEL=gpt-4o         # vision-capable model
OPENAI_API_KEY=
# OPENAI_BASE_URL=                     # optional: OpenAI-compatible endpoint

# --- Prompt planner (LLM #2: spec -> generation prompts) ---
CLEANROOM_TEXT_PROVIDER=mock          # mock | openai
CLEANROOM_TEXT_MODEL=gpt-4o

# --- Video generator (renders clips from prompts) ---
CLEANROOM_VIDEO_PROVIDER=mock        # mock (ffmpeg placeholder clips)

# --- Audio transcription (optional; describer feeds transcript to LLM #1) ---
CLEANROOM_TRANSCRIBER=mock           # mock | faster-whisper

# --- Misc ---
CLEANROOM_WORKDIR=assets/work
